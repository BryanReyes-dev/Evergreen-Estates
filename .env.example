# Public Supabase Data API / Storage configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Drizzle Kit migration connection (privileged; use only for migrations).
DIRECT_URL=

# Server-only read connection. Use the dedicated evergreen_runtime login,
# which has read-only application-table grants; never use postgres/admin here.
# Prefer the Supabase shared transaction pooler (port 6543); see README setup.
DRIZZLE_DATABASE_URL=

# Better Auth uses a separate, write-limited evergreen_auth login.
# Never reuse DRIZZLE_DATABASE_URL or the privileged DIRECT_URL here.
AUTH_DATABASE_URL=

# Server-only owner-scoped application writes. Use the evergreen_app login;
# do not reuse DIRECT_URL, DRIZZLE_DATABASE_URL, or AUTH_DATABASE_URL.
APP_DATABASE_URL=

# Better Auth server configuration. Keep the secret private (no NEXT_PUBLIC_ prefix).
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=

# Server-only transactional auth email via Resend. Verify the sender domain before deployment.
RESEND_API_KEY=
# Use an address on a Resend-verified domain, e.g. Evergreen Estates <auth@your-domain.example>.
AUTH_EMAIL_FROM=

# Server-only Supabase Storage credential.
# Never expose through NEXT_PUBLIC_ or commit the actual key.
SUPABASE_SECRET_KEY=
