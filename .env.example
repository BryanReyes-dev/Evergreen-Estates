# Public Supabase Data API / Storage configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Drizzle Kit migration connection (privileged; use only for migrations).
DIRECT_URL=

# Server-only runtime connection. Use a dedicated evergreen_runtime login
# that is a member of evergreen_readonly, not the postgres/admin account.
# Prefer the Supabase shared transaction pooler (port 6543); see README setup.
DRIZZLE_DATABASE_URL=

# Better Auth uses a separate, write-limited evergreen_auth login.
# Never reuse DRIZZLE_DATABASE_URL or the privileged DIRECT_URL here.
AUTH_DATABASE_URL=

# Better Auth server configuration. Keep the secret private (no NEXT_PUBLIC_ prefix).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
